# Names only. Copy to .env for local runs; .env is gitignored. Never put a real
# value in this file, and never commit one. In CI the same names are repository
# secrets and variables (docs/DESIGN.md section 9; what must exist first is in
# section 10), except the two marked "local only" at the end of this file, which the
# workflow does not pass. GitHub prints every repository VARIABLE in the step header
# of a public log: anything personal belongs in a SECRET.
#
# An empty value counts as unset. Booleans accept true/false, yes/no, 1/0, on/off.

# ---- Secrets -----------------------------------------------------------------

# Google Sheet: the tracker spreadsheet's ID (the long token in its URL).
SPREADSHEET_ID=

# Service account key (the JSON file Google gives you). In GitHub Actions the
# secret is the whole file, pasted as is (or its base64 encoding; the run decodes
# it). In a local .env it must be on ONE line:
# join the file's lines into one and leave the \n sequences inside the private key
# as they are. Or leave it blank here and set GCP_SERVICE_ACCOUNT_FILE (local runs
# only). If this one is set it wins, and a broken value is an error: the run does
# not fall back to the file.
GCP_SERVICE_ACCOUNT_KEY=

# Data.Dubai open API, "Real Estate Projects" dataset (needs a free registration
# and approval; until both are set the Dubai registry source is skipped).
DATA_DUBAI_API_KEY=
DATA_DUBAI_API_SECRET=

# Optional news discovery for Launch_Candidates (also needs ENABLE_GEMINI_NEWS).
GEMINI_API_KEY=

# Optional geocoder keys. The default backend needs none.
LOCATIONIQ_API_KEY=
GEOAPIFY_API_KEY=
# Opt-in only (GEOCODE_BACKEND=google); its terms restrict storing results.
GOOGLE_MAPS_API_KEY=

# Comma-separated addresses the sheet is shared with after creation.
SHARE_WITH_EMAILS=

# A way to reach whoever runs this (an email address or a web page), added to the
# User-Agent that public geocoders see; they ask for one. In CI this is a repository
# SECRET, not a variable (a variable's value is printed in the public job log), and it
# is the only way CI sets the contact: the User-Agent text itself is local only.
GEOCODE_CONTACT=

# ---- Variables ---------------------------------------------------------------

# (GOOGLE_SHEET_NAME, the spreadsheet's title when it is looked up by name, is local only:
# see the last block.)
# GEMINI_MODEL=
# ENABLE_SRERD=false
# ENABLE_GEMINI_NEWS=false

# Comma-separated source names that must succeed for a run to count as healthy.
# REQUIRE_SOURCES=
# Leave false: a source that returns fewer than 80 percent of its previous row count
# then fails the run. Nothing is ever deleted either way; true excuses such a drop
# (never an empty result).
# ALLOW_ROW_DROP=false

# Geocoding. Backends: nominatim (default), locationiq, geoapify, google.
# The default (nominatim) follows the public usage policy: one request per 15 s, 200 lookups a run,
# so at most 200 projects a day and fewer in practice (one project can need several lookups).
# LOCATIONIQ_API_KEY or GEOAPIFY_API_KEY (free tiers) makes it much faster.
# GEOCODE_ENABLED=true
# GEOCODE_BACKEND=
# GEOCODE_MAX_PER_RUN=0
# (GEOCODE_USER_AGENT is local only: see the last block. GEOCODE_CONTACT, a way to
# reach whoever runs this, is in the secrets block above.)
# GEOCODE_RETRY_COOLDOWN_DAYS=30
# Geocoding stops after this many seconds; 3300 is 55 minutes, room for 200 lookups
# paced 15 s apart inside the workflow's 90-minute job limit. A larger value is cut
# down to 4500 (75 minutes), so it cannot outrun that limit.
# GEOCODE_TIME_BUDGET_SECONDS=3300
# GEOCODE_FLUSH_EVERY=250

# Sharing: reader, commenter or writer.
# SHARE_ROLE=writer
# SHARE_NOTIFY=false

# Publish the map from CI to GitHub Pages (set as a repository variable; off until the owner
# turns it on once real data flows. Public Pages hosting is decided).
# Only the workflow's deploy job acts on it. The scrape step is never given it, so the
# start-up lines do not print it, and a value in a local .env changes nothing (a malformed
# one is warned about).
# DEPLOY_MAP=false
# UPLOAD_SNAPSHOT is a repository variable that only the workflow reads (it uploads the
# JSON snapshot as a downloadable artifact when set to true; off by default), so it has
# no line here. A setting that is not a valid yes/no, number or choice is reported by
# name only (the run never prints what was typed) and the default is used.

# ---- Local only --------------------------------------------------------------

# Path to the downloaded service account key file, relative to the repo root (or
# absolute). Never committed. Used only when GCP_SERVICE_ACCOUNT_KEY above is blank.
# (A key read from this file is not registered with the log scrubber; CI uses the
# secret, which is.)
# GCP_SERVICE_ACCOUNT_FILE=service_account.json

# Path to a copy of the DLD "Real Estate Projects" dataset downloaded by hand from its
# Data.Dubai page (JSON). When set, the Dubai registry source reads this file instead of
# calling the API, so no key is needed. Local runs only; the workflow never passes it.
# DATA_DUBAI_PROJECTS_FILE=

# The next two are read from a local .env only. The workflow does not pass them,
# because GitHub would print a variable's value in the public log; CI uses these
# defaults.
# Title of the spreadsheet when it is looked up by name (SPREADSHEET_ID is the normal way).
# GOOGLE_SHEET_NAME=UAE Real Estate Projects Tracker
# The geocoder's User-Agent. Put a way to reach you in GEOCODE_CONTACT instead of here.
# GEOCODE_USER_AGENT=uae-real-estate-scraper/1.0
